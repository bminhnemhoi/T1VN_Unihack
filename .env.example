# Names only. Copy to .env.local and fill in by hand (never commit real values).
# All keys are throw-away Avalanche Fuji testnet wallets (ADR-21).
FUJI_RPC_URL=
FUJI_RPC_URL_FALLBACK=
# PUBLIC: the browser reads from this RPC (inlined at build time, anyone can see it). Empty = Fuji public RPC.
# NEVER an RPC URL that carries an API key. https only; no user:pass@; not mainnet (docs/HOSTING.md section 6).
NEXT_PUBLIC_FUJI_RPC_URL=
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
ATTESTATION_ID_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Trợ lý chủ hụi (docs/04 mục 7.4), chỉ phía server. COPILOT_PROVIDER: openai-compatible (mặc định) hoặc anthropic.
# COPILOT_BASE_URL: gốc của router OpenAI-compatible (https; http chỉ cho localhost). COPILOT_MODEL: tên model do
# nhà cung cấp của bạn cung cấp (gợi ý: bản medium của router); không có giá trị mặc định trong code.
COPILOT_PROVIDER=
COPILOT_BASE_URL=
COPILOT_API_KEY=
COPILOT_MODEL=
# Chỉ dùng khi COPILOT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
SNOWTRACE_API_KEY=
# Demo wallets (testnet only)
DEMO_ORGANIZER_PRIVATE_KEY=
DEMO_M1_PRIVATE_KEY=
DEMO_M2_PRIVATE_KEY=
DEMO_M3_PRIVATE_KEY=
DEMO_M4_PRIVATE_KEY=
DEMO_M5_PRIVATE_KEY=
# Public addresses (not secrets), read by Deploy.s.sol, CreateSafe.s.sol and FundDemoWallets.s.sol on Fuji
ATTESTER_ADDRESS=
RELAYER_ADDRESS=
KEEPER_ADDRESS=
ORGANIZER_ADDRESS=
M1_ADDRESS=
M2_ADDRESS=
M3_ADDRESS=
M4_ADDRESS=
M5_ADDRESS=
# Safe 2/3 owners (public addresses of the people's own wallets, never a project role wallet) and the Safe itself
SAFE_OWNER_1=
SAFE_OWNER_2=
SAFE_OWNER_3=
ADMIN=
# FundDemoWallets: single (1 circle) or demoday (3 circles); JoinDemoCircles: DEMO_JOIN=all|fixed, DEMO_ACTIVATE=true|false
FUND_TARGET=
DEMO_JOIN=
DEMO_ACTIVATE=
# Which network the relay, attest and keeper use: fuji (default) or anvil (local rehearsal only)
HUISAFE_NETWORK=
ANVIL_RPC_URL=
# Keeper scan period in seconds (15 in demo mode, 300 for real circles)
KEEPER_INTERVAL_SECONDS=
# Demo circle script (CreateDemoCircle.s.sol), optional
JOIN_WINDOW_SECONDS=
DEMO_LABEL=
# Hạn mức IP của relay/attest chỉ tin x-forwarded-for khi đặt true (web sau đúng một proxy tin cậy ghi đè header); để trống = một nhóm chung
TRUST_PROXY=
